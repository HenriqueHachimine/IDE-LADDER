{
  "format": "ladderide-project",
  "format_version": 2,
  "name": "Transferencia rede/gerador",
  "description": "Supervisao com filtros, retentativas e intertravamento. A rede so e considerada ausente depois de 3 s sem ela (T0) e estavel depois de 10 s com ela (T1). Sem rede estavel o gerador e pedido: combustivel ligado e arranque por no maximo 5 s (T2), descanso de 5 s (T3) e nova tentativa; C0 conta as tentativas e na terceira sem pegar bloqueia ate o REARME. Transferencia: KG so fecha com a tensao do gerador estavel, o contato auxiliar do KR aberto e 1 s de tempo morto (T4); KR so fecha com o KG aberto e 1 s de tempo morto (T5). Na volta da rede o gerador sai da carga e gira 10 s sem carga (T6) antes de parar.",
  "version": "0.1.0",
  "created": "2026-11-14T06:48:41",
  "modified": "2026-11-14T06:48:41",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "n_words": 32,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020,
    "expansions": []
  },
