  "variables": [],
  "rungs": [
    {
      "comment": "FILTROS da rede: 3 s para falta",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Rede_OK"
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Falta",
          "preset": 3000
        }
      ]
    },
    {
      "comment": "e 10 s para estabilidade",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Rede_OK"
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Volta",
          "preset": 10000
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Volta.DN"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "S0.0"
              },
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Rede_OK"
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Rede_Estavel"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Falta.DN"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Rede_Estavel"
        }
      ]
    },
    {
      "comment": "PEDIDO do gerador",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Automatico"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Rede_Estavel"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Bloqueio"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Pedir_Gerador"
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Resfriando"
        }
      ]
    },
    {
      "comment": "Carga de volta na rede: resfria o motor",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pedir_Gerador"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Rede_Estavel"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "KR_Fechado"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Pedir_Gerador"
        },
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Resfriando"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Resfriando"
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Resfria",
          "preset": 10000
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Resfria.DN"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Resfriando"
        }
      ]
    },
    {
      "comment": "PARTIDA: arranque ate o motor girar, no maximo 5 s",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pedir_Gerador"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Gerador_Girando"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Descanso"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Bloqueio"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Motor_Partida"
        },
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Tentativa",
          "preset": 5000
        }
      ]
    },
    {
      "comment": "Nao pegou: descansa e conta a tentativa",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Tentativa.DN"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Descanso"
        },
        {
          "type": "counter",
          "kind": "CTU",
          "operand": "Tentativas",
          "preset": 3
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Descanso"
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Pausa",
          "preset": 5000
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pausa.DN"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Descanso"
        }
      ]
    },
    {
      "comment": "Terceira tentativa sem sucesso: bloqueio",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Tentativas.DN"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Bloqueio"
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Pedir_Gerador"
        }
      ]
    },
    {
      "comment": "Pegou: zera as tentativas",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Gerador_Girando"
        }
      ],
      "outputs": [
        {
          "type": "reset",
          "operand": "Tentativas"
        }
      ]
    },
    {
      "comment": "Rearme da falha de partida",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Rearme"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Bloqueio"
        },
        {
          "type": "reset",
          "operand": "Tentativas"
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Descanso"
        }
      ]
    },
    {
      "comment": "Combustivel com o gerador pedido ou resfriando",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Pedir_Gerador"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Resfriando"
              }
            ]
          ]
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Bloqueio"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Solenoide_Combustivel"
        }
      ]
    },
    {
      "comment": "TRANSFERENCIA: tempo morto depois de cada contator abrir de verdade",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Contator_KR"
