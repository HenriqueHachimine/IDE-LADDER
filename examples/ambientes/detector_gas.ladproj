  "variables": [],
  "rungs": [
    {
      "comment": "MEDIANA: comeca com D3 e troca se D1 ou D2 estiver no meio",
      "condition": [],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "Leitura_D3",
            "Mediana"
          ]
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "compare",
                "kind": "GEQ",
                "operands": [
                  "Leitura_D1",
                  "Leitura_D2"
                ]
              },
              {
                "type": "compare",
                "kind": "LEQ",
                "operands": [
                  "Leitura_D1",
                  "Leitura_D3"
                ]
              }
            ],
            [
              {
                "type": "compare",
                "kind": "LEQ",
                "operands": [
                  "Leitura_D1",
                  "Leitura_D2"
                ]
              },
              {
                "type": "compare",
                "kind": "GEQ",
                "operands": [
                  "Leitura_D1",
                  "Leitura_D3"
                ]
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "Leitura_D1",
            "Mediana"
          ]
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "compare",
                "kind": "GEQ",
                "operands": [
                  "Leitura_D2",
                  "Leitura_D1"
                ]
              },
              {
                "type": "compare",
                "kind": "LEQ",
                "operands": [
                  "Leitura_D2",
                  "Leitura_D3"
                ]
              }
            ],
            [
              {
                "type": "compare",
                "kind": "LEQ",
                "operands": [
                  "Leitura_D2",
                  "Leitura_D1"
                ]
              },
              {
                "type": "compare",
                "kind": "GEQ",
                "operands": [
                  "Leitura_D2",
                  "Leitura_D3"
                ]
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "Leitura_D2",
            "Mediana"
          ]
        }
      ]
    },
    {
      "comment": "DEFEITOS: distancia ate a mediana",
      "condition": [],
      "outputs": [
        {
          "type": "math",
          "kind": "SUB",
          "operands": [
            "Leitura_D1",
            "Mediana",
            "Dif_D1"
          ]
        }
      ]
    },
    {
      "comment": "Longe da mediana por 10 s: descalibrado",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "compare",
                "kind": "LES",
                "operands": [
                  "Dif_D1",
                  "-100"
                ]
              }
            ],
            [
              {
                "type": "compare",
                "kind": "GRT",
                "operands": [
                  "Dif_D1",
                  "100"
                ]
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Discord_D1",
          "preset": 10000
        }
      ]
    },
    {
      "comment": "Abaixo da faixa: laco 4-20 mA aberto",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Discord_D1.DN"
