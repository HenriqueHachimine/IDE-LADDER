          "type": "math",
          "kind": "NEG",
          "operands": [
            "Duty",
            "Duty_Frio"
          ]
        },
        {
          "type": "math",
          "kind": "SUB",
          "operands": [
            "Setpoint",
            "25",
            "Antecipacao"
          ]
        },
