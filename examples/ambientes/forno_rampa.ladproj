    {
      "comment": "CONTROLE: 25 ms por degC de erro + antecipacao da perda pelas paredes ((SP - 25) / 2)",
      "condition": [],
      "outputs": [
        {
          "type": "math",
          "kind": "DIV",
          "operands": [
            "SP_x10",
            "10",
            "Setpoint"
          ]
        },
