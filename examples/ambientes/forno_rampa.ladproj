          "type": "math",
          "kind": "DIV",
          "operands": [
            "Antecipacao",
            "2",
            "Antecipacao"
          ]
        },
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Duty",
            "Antecipacao",
            "Duty"
          ]
        }
      ]
    },
