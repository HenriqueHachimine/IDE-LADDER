{
  "format": "ladderide-project",
  "format_version": 2,
  "name": "Separacao por altura",
  "description": "Rastreamento com registrador de deslocamento sincronizado pelo encoder. Enquanto a caixa passa pela estacao, o sensor alto memoriza se ela e alta; quando ela termina de passar (borda de descida do sensor baixo), uma caixa alta marca o bit 0 de N5. Cada pulso do encoder (20 px de esteira) multiplica N5 por 2 (so 13 bits: acima de 8191 subtrai 8192), e a marcacao vem depois do deslocamento. Com a caixa no centro do desviador a marca esta perto do bit 11: a janela dos bits 9, 10 e 11 liga o desviador um pouco antes da caixa chegar e so desliga depois que ela passou.",
  "version": "0.1.0",
  "created": "2026-11-14T07:30:49",
  "modified": "2026-11-14T07:30:49",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "n_words": 32,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020,
    "expansions": []
  },
  "symbols": [
    {
      "name": "Liga",
      "address": "I0.0",
      "comment": "Chave LIGA"
    },
    {
      "name": "Sensor_Baixo",
      "address": "I0.1",
      "comment": "Sensor de altura baixo (vê toda caixa)"
    },
    {
      "name": "Sensor_Alto",
      "address": "I0.2",
      "comment": "Sensor de altura alto (só caixas altas)"
    },
    {
      "name": "Encoder",
      "address": "I0.3",
      "comment": "Encoder da esteira (um pulso a cada 20 px)"
    },
    {
      "name": "Fim_Altas",
      "address": "I0.4",
      "comment": "Caixa no fim da esteira das altas"
    },
    {
      "name": "Fim_Baixas",
      "address": "I0.5",
      "comment": "Caixa no fim da esteira das baixas"
    },
    {
      "name": "Esteira_Entrada",
      "address": "Q0.0",
      "comment": "Esteira de entrada"
    },
    {
      "name": "Desviador",
      "address": "Q0.1",
      "comment": "Desviador de rodas: para a esteira das altas"
    },
    {
      "name": "Esteira_Altas",
      "address": "Q0.2",
      "comment": "Esteira das caixas altas"
    },
    {
      "name": "Esteira_Baixas",
      "address": "Q0.3",
      "comment": "Esteira das caixas baixas"
    },
    {
      "name": "Emissor",
      "address": "Q0.4",
      "comment": "Emissor de caixas"
    },
    {
      "name": "Luz_Operando",
      "address": "Q0.5",
      "comment": "Lâmpada operando"
    },
    {
      "name": "Registro",
      "address": "N5",
      "comment": "rastreamento: bit k = caixa alta k pulsos depois da estacao"
    },
    {
      "name": "Pulso",
      "address": "M0.5",
      "comment": "borda de subida do encoder"
    },
    {
      "name": "Alta_Lida",
      "address": "M0.0",
      "comment": "caixa alta em leitura"
    },
    {
      "name": "Baixo_Anterior",
      "address": "M0.1",
      "comment": "sensor baixo na varredura anterior"
    },
    {
      "name": "Encoder_Anterior",
      "address": "M0.2",
      "comment": "encoder na varredura anterior"
    },
    {
      "name": "Fim_Leitura",
      "address": "M0.6",
      "comment": "borda de descida do sensor baixo"
    },
    {
      "name": "Altas_Lidas",
      "address": "N6",
      "comment": "altas identificadas"
    },
    {
      "name": "Baixas_Lidas",
      "address": "N7",
      "comment": "baixas identificadas"
    },
    {
      "name": "Altas_Fim",
      "address": "N8",
      "comment": "altas no fim"
    },
    {
      "name": "Baixas_Fim",
      "address": "N9",
      "comment": "baixas no fim"
    },
    {
      "name": "Fim_Altas_Ant",
      "address": "M1.0",
      "comment": "borda do fim das altas"
    },
    {
      "name": "Fim_Baixas_Ant",
      "address": "M1.1",
      "comment": "borda do fim das baixas"
    }
  ],
  "variables": [],
  "rungs": [
    {
      "comment": "Liga a linha",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Liga"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Entrada"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Altas"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Baixas"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Emissor"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Luz_Operando"
        }
      ]
    },
    {
      "comment": "LEITURA: o sensor alto viu a caixa em algum momento",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Baixo"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Alto"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Alta_Lida"
        }
      ]
    },
    {
      "comment": "A caixa terminou de passar pela estacao",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Sensor_Baixo"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Baixo_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Fim_Leitura"
        }
      ]
    },
    {
      "comment": "Borda de subida do encoder: um pulso a cada 20 px",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Encoder"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Encoder_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Pulso"
        }
      ]
    },
    {
      "comment": "DESLOCAMENTO: a marca anda um bit junto com a caixa",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MUL",
          "operands": [
            "Registro",
            "2",
            "Registro"
          ]
        }
      ]
    },
    {
      "comment": "So 13 bits",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        },
        {
          "type": "compare",
          "kind": "GEQ",
          "operands": [
            "Registro",
            "8192"
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "SUB",
          "operands": [
            "Registro",
            "8192",
            "Registro"
          ]
        }
      ]
    },
    {
      "comment": "Caixa alta: marca o bit 0 (depois do deslocamento)",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Leitura"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Alta_Lida"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Registro",
            "1",
            "Registro"
          ]
        },
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Altas_Lidas",
            "1",
            "Altas_Lidas"
          ]
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Alta_Lida"
        }
      ]
    },
    {
      "comment": "Caixa baixa",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Leitura"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Alta_Lida"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Baixas_Lidas",
            "1",
            "Baixas_Lidas"
          ]
        }
      ]
    },
    {
      "comment": "JANELA do desviador: bits 9, 10 e 11",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "compare",
                "kind": "MEQ",
                "operands": [
                  "Registro",
                  "1024",
                  "1024"
                ]
              }
            ],
            [
              {
                "type": "compare",
                "kind": "MEQ",
                "operands": [
                  "Registro",
                  "2048",
                  "2048"
                ]
              }
            ],
            [
              {
                "type": "compare",
                "kind": "MEQ",
                "operands": [
                  "Registro",
                  "512",
                  "512"
                ]
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Desviador"
        }
      ]
    },
    {
      "comment": "Imagens anteriores",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Baixo"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Baixo_Anterior"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Encoder"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Encoder_Anterior"
        }
      ]
    },
    {
      "comment": "VERIFICACAO: chegadas no fim de cada esteira",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Altas"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Fim_Altas_Ant"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Altas_Fim",
            "1",
            "Altas_Fim"
          ]
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Altas"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Fim_Altas_Ant"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Baixas"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Fim_Baixas_Ant"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Baixas_Fim",
            "1",
            "Baixas_Fim"
          ]
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Baixas"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Fim_Baixas_Ant"
        }
      ]
    }
  ],
  "history": [
    {
      "date": "2026-11-14T07:30:49",
      "action": "gerado por scripts/make_examples.py",
      "rungs": 15
    }
  ],
