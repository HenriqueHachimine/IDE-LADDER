{
  "format": "ladderide-project",
  "format_version": 2,
  "name": "Separacao por altura",
  "description": "Rastreamento com registrador de deslocamento sincronizado pelo encoder. Cada pulso do encoder (20 px de esteira) desloca o registro N5 um bit para a direita (DIV por 2); se o sensor alto ve caixa nesse pulso, o bit 11 entra em 1 (ADD 2048). Onze pulsos depois a informacao chega ao bit 0, que fica no desviador: MEQ Registro 1 1 liga o desviador enquanto a parte alta da caixa passa. Assim varias caixas cabem entre a estacao de altura e o desviador sem misturar a informacao.",
  "version": "0.1.0",
  "created": "2026-11-14T07:12:02",
  "modified": "2026-11-14T07:12:02",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "n_words": 32,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020,
    "expansions": []
  },
  "symbols": [
    {
      "name": "Liga",
      "address": "I0.0",
      "comment": "Chave LIGA"
    },
    {
      "name": "Sensor_Baixo",
      "address": "I0.1",
      "comment": "Sensor de altura baixo (vê toda caixa)"
    },
    {
      "name": "Sensor_Alto",
      "address": "I0.2",
      "comment": "Sensor de altura alto (só caixas altas)"
    },
    {
      "name": "Encoder",
      "address": "I0.3",
      "comment": "Encoder da esteira (um pulso a cada 20 px)"
    },
    {
      "name": "Fim_Altas",
      "address": "I0.4",
      "comment": "Caixa no fim da esteira das altas"
    },
    {
      "name": "Fim_Baixas",
      "address": "I0.5",
      "comment": "Caixa no fim da esteira das baixas"
    },
    {
      "name": "Esteira_Entrada",
      "address": "Q0.0",
      "comment": "Esteira de entrada"
    },
    {
      "name": "Desviador",
      "address": "Q0.1",
      "comment": "Desviador de rodas: para a esteira das altas"
    },
    {
      "name": "Esteira_Altas",
      "address": "Q0.2",
      "comment": "Esteira das caixas altas"
    },
    {
      "name": "Esteira_Baixas",
      "address": "Q0.3",
      "comment": "Esteira das caixas baixas"
    },
    {
      "name": "Emissor",
      "address": "Q0.4",
      "comment": "Emissor de caixas"
    },
    {
      "name": "Luz_Operando",
      "address": "Q0.5",
      "comment": "Lâmpada operando"
    },
    {
      "name": "Registro",
      "address": "N5",
      "comment": "registrador de deslocamento (bit 11 na estacao, bit 0 no desviador)"
    },
    {
      "name": "Pulso",
      "address": "M0.0",
      "comment": "borda de subida do encoder"
    },
    {
      "name": "Encoder_Anterior",
      "address": "M0.1",
      "comment": "encoder na varredura anterior"
    },
    {
      "name": "Altas",
      "address": "C0",
      "comment": "caixas altas entregues"
    },
    {
      "name": "Baixas",
      "address": "C1",
      "comment": "caixas baixas entregues"
    },
    {
      "name": "Fim_Altas_Ant",
      "address": "M0.2",
      "comment": "borda do fim das altas"
    },
    {
      "name": "Fim_Baixas_Ant",
      "address": "M0.3",
      "comment": "borda do fim das baixas"
    }
  ],
  "variables": [],
  "rungs": [
    {
      "comment": "Liga a linha",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Liga"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Entrada"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Altas"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Baixas"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Emissor"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Luz_Operando"
        }
      ]
    },
    {
      "comment": "Borda de subida do encoder: um pulso a cada 20 px",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Encoder"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Encoder_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Pulso"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Encoder"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Encoder_Anterior"
        }
      ]
    },
    {
      "comment": "DESLOCAMENTO: tudo anda um bit em direcao ao desviador",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "DIV",
          "operands": [
            "Registro",
            "2",
            "Registro"
          ]
        }
      ]
    },
    {
      "comment": "Caixa alta na estacao: bit 11 em 1",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Alto"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Registro",
            "2048",
            "Registro"
          ]
        }
      ]
    },
    {
      "comment": "Bit 0 chegou ao desviador: caixa alta passando",
      "condition": [
        {
          "type": "compare",
          "kind": "MEQ",
          "operands": [
            "Registro",
            "1",
            "1"
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Desviador"
        }
      ]
    },
    {
      "comment": "CONTAGEM das entregas",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Altas"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Fim_Altas_Ant"
        }
      ],
      "outputs": [
        {
          "type": "counter",
          "kind": "CTU",
          "operand": "Altas",
          "preset": 9999
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Altas"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Fim_Altas_Ant"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Baixas"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Fim_Baixas_Ant"
        }
      ],
      "outputs": [
        {
          "type": "counter",
          "kind": "CTU",
          "operand": "Baixas",
          "preset": 9999
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Fim_Baixas"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Fim_Baixas_Ant"
        }
      ]
    }
  ],
  "history": [
    {
      "date": "2026-11-14T07:12:02",
      "action": "gerado por scripts/make_examples.py",
      "rungs": 10
    }
  ],
