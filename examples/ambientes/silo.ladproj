{
  "format": "ladderide-project",
  "format_version": 1,
  "name": "Silo de envase",
  "description": "Esteira para com a caixa sob o bico, enche ate o sensor de nivel e segue. A caixa cheia e memorizada (M0.0) porque o sensor de nivel deixa de ve-la quando ela anda, enquanto a fotocelula continua interrompida ate a caixa sair. Stop e NF: o programa usa contato NA (XIC).",
  "version": "0.1.0",
  "created": "2026-10-17T13:17:57",
  "modified": "2026-10-17T13:17:57",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020
  },
  "symbols": [
    {
      "name": "Start",
      "address": "I0.0",
      "comment": "Botao de partida (NA)"
    },
    {
      "name": "Stop",
      "address": "I0.1",
      "comment": "Botao de parada (NF: le 1 quando solto)"
    },
    {
      "name": "Sensor_Presenca",
      "address": "I0.2",
      "comment": "Fotocelula: caixa interrompendo o feixe sob o bico"
    },
    {
      "name": "Sensor_Nivel",
      "address": "I0.3",
      "comment": "Sensor de nivel: caixa sob o bico com 95% ou mais"
    },
    {
      "name": "Motor_Esteira",
      "address": "Q0.0",
      "comment": "Motor da esteira"
    },
    {
      "name": "Valvula",
      "address": "Q0.1",
      "comment": "Valvula solenoide do silo"
    },
    {
      "name": "Lampada_Run",
      "address": "Q0.2",
      "comment": "Lampada RUN (processo ligado)"
    },
    {
      "name": "Lampada_Fill",
      "address": "Q0.3",
      "comment": "Lampada FILL (enchendo)"
    },
    {
      "name": "Lampada_Full",
      "address": "Q0.4",
      "comment": "Lampada FULL (caixa cheia)"
    },
    {
      "name": "Caixa_Cheia",
      "address": "M0.0",
      "comment": "caixa sob o bico ja foi enchida"
    }
  ],
  "rungs": [
    {
      "comment": "Liga/desliga o processo (selo)",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Start"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Lampada_Run"
              }
            ]
          ]
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Stop"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Lampada_Run"
        }
      ]
    },
    {
      "comment": "Memoriza caixa cheia (o sensor de nivel para de ver a caixa quando ela anda)",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Nivel"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Caixa_Cheia"
        }
      ]
    },
    {
      "comment": "Feixe livre: a caixa cheia saiu, espera a proxima",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Sensor_Presenca"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Caixa_Cheia"
        }
      ]
    },
    {
      "comment": "Esteira anda sem caixa no bico ou com a caixa cheia",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Lampada_Run"
        },
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIO",
                "operand": "Sensor_Presenca"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Caixa_Cheia"
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Motor_Esteira"
        }
      ]
    },
    {
      "comment": "Enche a caixa posicionada",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Lampada_Run"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sensor_Presenca"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Caixa_Cheia"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Valvula"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Lampada_Fill"
        }
      ]
    },
    {
      "comment": "Sinaliza caixa cheia",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Lampada_Run"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Caixa_Cheia"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Lampada_Full"
        }
      ]
    }
  ],
  "history": [
    {
      "date": "2026-10-17T13:17:57",
      "action": "gerado por scripts/make_examples.py",
      "rungs": 6
    }
  ],
  "build": {
    "compiler_version": "1.0.0",
    "format": "LDRB 1.0",
    "build_id": "0x83581390",
    "size": 200,
    "instructions": 41,
    "date": "2026-10-17T13:17:57"
  },
  "environment": "silo"
}