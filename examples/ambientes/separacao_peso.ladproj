  "variables": [],
  "rungs": [
    {
      "comment": "Liga a linha",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Liga"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Entrada"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Emissor"
        },
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Luz_Operando"
        }
      ]
    },
    {
      "comment": "BALANCA: para com a caixa ainda nao pesada sobre a plataforma",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Liga"
        },
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIO",
                "operand": "Caixa_Na_Balanca"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Pesada"
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Balanca"
        }
      ]
    },
    {
      "comment": "Peso estavel e lugar na fila",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Caixa_Na_Balanca"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Peso_Estavel"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Pesada"
        },
        {
          "type": "compare",
          "kind": "EQU",
          "operands": [
            "Fila_5",
            "0"
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Pesar"
        }
      ]
    },
    {
      "comment": "CLASSE: 1 no peso",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pesar"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "1",
            "Classe"
          ]
        }
      ]
    },
    {
      "comment": "2 leve (abaixo de 450 g)",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pesar"
        },
        {
          "type": "compare",
          "kind": "LES",
          "operands": [
            "Peso",
            "450"
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "2",
            "Classe"
          ]
        }
      ]
    },
    {
      "comment": "3 pesada (acima de 550 g)",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pesar"
        },
        {
          "type": "compare",
          "kind": "GRT",
          "operands": [
            "Peso",
            "550"
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "3",
            "Classe"
          ]
        }
      ]
    },
    {
      "comment": "SAIDA DA FILA: a caixa deixou o transferidor",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Caixa_No_Transferidor"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Transf_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Saiu"
        }
      ]
    },
    {
      "comment": "A fila anda um lugar",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Saiu"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "Fila_2",
            "Fila_1"
          ]
        },
        {
          "type": "math",
