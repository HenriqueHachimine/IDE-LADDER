    },
    {
      "name": "Transfere_Pesadas",
      "address": "Q0.4",
      "comment": "Transferidor: leva a caixa para a rampa das pesadas"
    },
    {
      "name": "Emissor",
      "address": "Q0.5",
      "comment": "Emissor de caixas"
    },
    {
      "name": "Luz_Operando",
      "address": "Q0.6",
      "comment": "Lâmpada operando"
    },
