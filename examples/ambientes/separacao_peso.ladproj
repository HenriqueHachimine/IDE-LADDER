      "address": "N0",
      "comment": "peso na balanca (g)"
    },
    {
      "name": "Classe",
      "address": "N10",
      "comment": "classe da caixa pesada"
    },
    {
      "name": "Fila_1",
      "address": "N20",
      "comment": "classe da caixa que chega ao transferidor"
    },
    {
      "name": "Fila_2",
      "address": "N21",
      "comment": ""
    },
    {
      "name": "Fila_3",
      "address": "N22",
      "comment": ""
    },
    {
      "name": "Fila_4",
      "address": "N23",
      "comment": ""
    },
    {
      "name": "Fila_5",
      "address": "N24",
      "comment": "ultimo lugar da fila"
    },
