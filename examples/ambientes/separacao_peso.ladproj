      "comment": "Caixa inteira sobre a plataforma da balança"
    },
    {
      "name": "Peso_Estavel",
      "address": "I0.2",
      "comment": "Leitura da balança estável (N0 vale)"
    },
    {
      "name": "Caixa_No_Transferidor",
      "address": "I0.3",
      "comment": "Fotocélula: caixa centrada no transferidor"
    },
    {
      "name": "Esteira_Entrada",
      "address": "Q0.0",
      "comment": "Esteira de entrada"
    },
    {
      "name": "Esteira_Balanca",
