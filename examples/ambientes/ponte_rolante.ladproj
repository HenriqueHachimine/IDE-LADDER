      "comment": "Velocidade baixa (aproximação)"
    },
    {
      "name": "Libera_Freio",
      "address": "Q0.3",
      "comment": "Solta o freio (sem energia o freio atua)"
    },
    {
      "name": "Lampada_Pronta",
      "address": "Q0.4",
      "comment": "Lâmpada PRONTA (pisca com erro)"
    },
    {
      "name": "Guincho_Sobe",
      "address": "Q0.5",
      "comment": "Guincho: sobe"
    },
    {
      "name": "Guincho_Desce",
      "address": "Q0.6",
      "comment": "Guincho: desce"
    },
    {
      "name": "Eletroima",
      "address": "Q0.7",
      "comment": "Eletroímã do gancho"
    },
    {
