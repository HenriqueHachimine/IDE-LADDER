        {
          "type": "coil",
          "kind": "OTU",
          "operand": "E1_Ir_Origem"
        }
      ]
    },
    {
      "comment": "Espera o balanco parar antes de descer",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
