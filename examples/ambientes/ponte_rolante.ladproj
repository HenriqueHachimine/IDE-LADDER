{
  "format": "ladderide-project",
  "format_version": 2,
  "name": "Ponte rolante com guincho",
  "description": "Posicionamento por encoder mais sequencia de transporte. Conta as duas bordas do encoder (10 mm cada) pelo sentido do ultimo movimento; ao ligar, referencia na chave de origem. Tarefa: E1 vai a estacao de origem (N10 convertido em posicao), E2 espera 3 s o balanco e desce ate apoiar, E3 liga o eletroima ate a carga prender, E4 sobe ao topo, E5 vai ao destino (N11), E6 espera e desce, E7 solta, E8 sobe vazio. A translacao so anda nas etapas E1/E5 (gancho no topo). Sem chapa na origem a tarefa aborta e a lampada pisca.",
  "version": "0.1.0",
  "created": "2026-11-14T06:25:17",
  "modified": "2026-11-14T06:25:17",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "n_words": 32,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020,
    "expansions": []
  },
  "symbols": [
    {
      "name": "Encoder",
      "address": "I0.0",
      "comment": "Encoder incremental (1 ciclo / 20 mm)"
    },
    {
      "name": "Origem",
      "address": "I0.1",
      "comment": "Chave de origem (posição 0 mm)"
    },
    {
      "name": "Gancho_Topo",
      "address": "I0.2",
      "comment": "Gancho em cima (fim de curso do guincho)"
    },
    {
      "name": "Gancho_Apoiado",
      "address": "I0.3",
      "comment": "Gancho apoiado (cabo frouxo: tocou a chapa ou o piso)"
    },
    {
      "name": "Carga_Presa",
      "address": "I0.4",
      "comment": "Eletroímã segurando uma chapa"
    },
    {
      "name": "Iniciar",
      "address": "I0.5",
      "comment": "Botão INICIAR transporte"
    },
    {
      "name": "Carga_Sob_Gancho",
      "address": "I0.6",
      "comment": "Sensor: chapa embaixo do gancho"
    },
    {
      "name": "Emergencia",
      "address": "I0.7",
      "comment": "Emergência com trava (NF: lê 1 quando liberada)"
    },
    {
      "name": "Motor_Direita",
      "address": "Q0.0",
      "comment": "Translação: direita"
    },
    {
      "name": "Motor_Esquerda",
      "address": "Q0.1",
      "comment": "Translação: esquerda"
    },
    {
      "name": "Velocidade_Lenta",
