        }
      ]
    },
    {
      "comment": "Eletroima segurando",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "E3_Pegar"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Prende.DN"
