  "variables": [],
  "rungs": [
    {
      "comment": "ENCODER: borda de subida ou de descida = 10 mm",
      "condition": [
        {
          "type": "parallel",
          "branches": [
            [
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Encoder"
              },
              {
                "type": "contact",
                "kind": "XIO",
                "operand": "Encoder_Anterior"
              }
            ],
            [
              {
                "type": "contact",
                "kind": "XIO",
                "operand": "Encoder"
              },
              {
                "type": "contact",
                "kind": "XIC",
                "operand": "Encoder_Anterior"
              }
            ]
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Pulso"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Encoder"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Encoder_Anterior"
        }
      ]
    },
    {
      "comment": "Lembra o sentido do movimento",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Motor_Direita"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Sentido_Direita"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Motor_Esquerda"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Sentido_Direita"
        }
      ]
    },
    {
      "comment": "Conta a posicao",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Sentido_Direita"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Posicao",
            "1",
            "Posicao"
          ]
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Sentido_Direita"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "SUB",
          "operands": [
            "Posicao",
            "1",
            "Posicao"
          ]
        }
      ]
    },
    {
      "comment": "Referenciamento: origem = 0 mm",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Origem"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Referenciado"
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "0",
            "Posicao"
          ]
        },
        {
          "type": "math",
          "kind": "MOV",
          "operands": [
            "0",
            "Destino"
          ]
        },
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Referenciado"
        },
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "E0_Livre"
        }
      ]
    },
    {
      "comment": "TAREFA: INICIAR com o gancho no topo",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "E0_Livre"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Iniciar"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Referenciado"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Gancho_Topo"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Erro"
        },
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "E1_Ir_Origem"
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "E0_Livre"
        }
      ]
    },
    {
      "comment": "Carga no topo: vai ao destino (antes da tabela, para o alvo ja mudar nesta varredura)",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "E4_Subir_Carga"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Gancho_Topo"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "E5_Ir_Destino"
        },
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "E4_Subir_Carga"
        }
      ]
    },
    {
      "comment": "Estacao de origem em posicao (passos de 10 mm)",
      "condition": [
