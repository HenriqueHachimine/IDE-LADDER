      "comment": "1 a 5, escolhida no painel"
    },
    {
      "name": "Estacao_Destino",
      "address": "N11",
      "comment": "1 a 5, escolhida no painel"
    },
    {
      "name": "Referenciado",
      "address": "M0.0",
      "comment": "origem encontrada"
    },
    {
