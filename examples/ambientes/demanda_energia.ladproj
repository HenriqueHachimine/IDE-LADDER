  "variables": [],
  "rungs": [
    {
      "comment": "PROJECAO da media no fim da janela",
      "condition": [],
      "outputs": [
        {
          "type": "math",
          "kind": "MUL",
          "operands": [
            "Potencia",
            "Restante",
            "Calculo"
          ]
        },
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Calculo",
            "Energia",
            "Calculo"
          ]
        },
        {
          "type": "math",
          "kind": "DIV",
          "operands": [
            "Calculo",
            "120",
            "Projecao"
          ]
        }
      ]
    },
    {
      "comment": "Faixa de atuacao: 88% a 97% do contrato",
      "condition": [],
      "outputs": [
        {
          "type": "math",
          "kind": "MUL",
          "operands": [
            "Contrato",
            "97",
            "Limite_Alto"
          ]
        },
        {
          "type": "math",
          "kind": "DIV",
          "operands": [
            "Limite_Alto",
            "100",
            "Limite_Alto"
          ]
        },
        {
          "type": "math",
          "kind": "MUL",
          "operands": [
            "Contrato",
            "88",
            "Limite_Baixo"
          ]
        },
        {
          "type": "math",
          "kind": "DIV",
          "operands": [
            "Limite_Baixo",
            "100",
            "Limite_Baixo"
          ]
        }
      ]
    },
    {
      "comment": "ESTAGIOS: um passo a cada 4 s",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Passo.DN"
        }
      ],
      "outputs": [
        {
          "type": "timer",
          "kind": "TON",
          "operand": "Passo",
          "preset": 4000
        }
      ]
    },
    {
      "comment": "Projecao alta: corta mais uma carga",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Passo.DN"
        },
        {
          "type": "compare",
          "kind": "GRT",
          "operands": [
            "Projecao",
            "Limite_Alto"
          ]
        },
        {
          "type": "compare",
          "kind": "LES",
          "operands": [
            "Estagio",
            "4"
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "ADD",
          "operands": [
            "Estagio",
            "1",
            "Estagio"
          ]
        }
      ]
    },
    {
      "comment": "Projecao baixa: devolve uma carga",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Passo.DN"
        },
        {
          "type": "compare",
          "kind": "LES",
          "operands": [
            "Projecao",
            "Limite_Baixo"
          ]
        },
        {
          "type": "compare",
          "kind": "GRT",
          "operands": [
            "Estagio",
            "0"
          ]
        }
      ],
      "outputs": [
        {
          "type": "math",
          "kind": "SUB",
          "operands": [
            "Estagio",
            "1",
            "Estagio"
          ]
        }
      ]
    },
    {
      "comment": "RODIZIO: troca qual ar-condicionado sai primeiro a cada janela",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Pulso_Sincronismo"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Sinc_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Troca_Rodizio"
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Troca_Rodizio"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Vez_AC2"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTU",
          "operand": "Vez_AC2"
        },
        {
          "type": "coil",
          "kind": "OTU",
