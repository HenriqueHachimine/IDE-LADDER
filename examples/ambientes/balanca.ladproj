{
  "format": "ladderide-project",
  "format_version": 2,
  "name": "Dosagem por receita",
  "description": "Aritmetica com setpoint e tara. Com o recipiente vazio parado, guarda a tara (N3) e calcula o alvo bruto de A (N4 = tara + N1). A: grossa ate 150 g antes, fina ate o corte antecipado (N6). Assentado, mede o erro de A, corrige o corte e calcula o alvo bruto de B (peso atual + N2). B: uma valvula ate o seu corte (N10). Erros dentro de 2% (minimo 3 g, LIM) acendem OK; senao REJEITO e o rejeitador empurra o recipiente quando ele passa por I0.4.",
  "version": "0.1.0",
  "created": "2026-11-13T23:31:58",
  "modified": "2026-11-13T23:31:58",
  "io": {
    "n_inputs": 8,
    "n_outputs": 8,
    "n_markers": 64,
    "n_words": 32,
    "safe_outputs": 0,
    "scan_period_ms": 10
  },
  "target": {
    "device": "esp32-relay-x8",
    "transport": "serial",
    "port": "",
    "baudrate": 115200,
    "host": "",
    "tcp_port": 5020,
