          "kind": "XIC",
          "operand": "Empurrador_Recuado"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Esteira_Entrada"
        }
      ]
    },
    {
      "comment": "Amarracao: camadas pares (C2.ACC impar) com as caixas giradas",
      "condition": [
        {
          "type": "compare",
          "kind": "MEQ",
          "operands": [
            "Camadas.ACC",
            "1",
            "1"
          ]
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Girador"
        }
      ]
    },
    {
      "comment": "FILAS: fila completa, lugar na placa e pallet ainda nao completo",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Caixas.DN"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Filas.DN"
        },
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Camadas.DN"
