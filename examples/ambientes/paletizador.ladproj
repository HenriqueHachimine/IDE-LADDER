    {
      "comment": "Partida: alinha o pallet com a placa",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "S0.0"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTL",
          "operand": "Subir_Pallet"
        }
      ]
    },
    {
      "comment": "CAIXAS: conta quando a caixa termina de entrar na mesa",
      "condition": [
        {
          "type": "contact",
          "kind": "XIO",
          "operand": "Caixa_Entrando"
        },
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Foto_Anterior"
        }
      ],
      "outputs": [
        {
          "type": "counter",
          "kind": "CTU",
          "operand": "Caixas",
          "preset": 3
        }
      ]
    },
    {
      "comment": "",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Caixa_Entrando"
        }
      ],
      "outputs": [
        {
          "type": "coil",
          "kind": "OTE",
          "operand": "Foto_Anterior"
        }
      ]
    },
    {
      "comment": "Esteira ate completar a fila",
      "condition": [
        {
          "type": "contact",
          "kind": "XIC",
          "operand": "Liga"
