{
  "base_program": [".inputs 8", ".outputs 8", ".markers 8", ".timer T0 TON 100", ".counter C0 UP 3",
                   "SOR", "XIC I0.0", "TON T0", "EOR",
                   "SOR", "XIC T0.DN", "CTU C0", "EOR"],
  "base_layout": "cabecalho 0..31 | T0 32..39 | C0 40..47 | instrucao i em 48+4i (SOR,XIC,TON,EOR,SOR,XIC,CTU,EOR) | CRC nos 4 ultimos bytes",
  "cases": [
    {"name": "base_valida", "expect": "OK"},
    {"name": "programa_vazio", "program": [".inputs 8", ".outputs 8"], "expect": "OK"},
    {"name": "curta_demais", "truncate": 10, "expect": "TOO_SHORT"},
    {"name": "assinatura", "patch": [{"offset": 0, "hex": "58"}], "expect": "BAD_MAGIC"},
    {"name": "versao_maior", "patch": [{"offset": 4, "hex": "02"}], "expect": "UNSUPPORTED_VERSION"},
    {"name": "versao_menor_futura", "patch": [{"offset": 5, "hex": "01"}], "expect": "UNSUPPORTED_VERSION"},
    {"name": "tamanho_cabecalho", "patch": [{"offset": 6, "hex": "2100"}], "expect": "BAD_HEADER_SIZE"},
    {"name": "byte_extra", "append": "00", "expect": "SIZE_MISMATCH"},
    {"name": "crc_corrompido", "patch": [{"offset": 48, "hex": "10"}], "expect": "BAD_CRC"},
    {"name": "flags_reservadas", "patch": [{"offset": 28, "hex": "01"}], "fix_crc": true, "expect": "RESERVED_NONZERO"},
    {"name": "marcadores_demais", "patch": [{"offset": 14, "hex": "2c01"}], "fix_crc": true, "expect": "LIMIT_EXCEEDED"},
    {"name": "contagem_temporizadores_inconsistente", "patch": [{"offset": 16, "hex": "02"}], "fix_crc": true, "expect": "SIZE_MISMATCH"},
    {"name": "saida_segura_fora_da_faixa", "patch": [{"offset": 22, "hex": "0001"}], "fix_crc": true, "expect": "RESERVED_NONZERO"},
    {"name": "redes_declaradas_a_mais", "patch": [{"offset": 18, "hex": "0300"}], "fix_crc": true, "expect": "BAD_STRUCTURE", "index": 8},
    {"name": "redes_declaradas_a_menos", "patch": [{"offset": 18, "hex": "0100"}], "fix_crc": true, "expect": "BAD_STRUCTURE", "index": 4},
    {"name": "tipo_temporizador", "patch": [{"offset": 32, "hex": "03"}], "fix_crc": true, "expect": "BAD_TIMER_TABLE"},
    {"name": "reservado_temporizador", "patch": [{"offset": 33, "hex": "01"}], "fix_crc": true, "expect": "BAD_TIMER_TABLE"},
    {"name": "preset_temporizador", "patch": [{"offset": 36, "hex": "00000080"}], "fix_crc": true, "expect": "BAD_TIMER_TABLE"},
    {"name": "tipo_contador", "patch": [{"offset": 40, "hex": "02"}], "fix_crc": true, "expect": "BAD_COUNTER_TABLE"},
    {"name": "opcode_desconhecido", "patch": [{"offset": 48, "hex": "99"}], "fix_crc": true, "expect": "BAD_OPCODE", "index": 0},
    {"name": "sor_dentro_de_rede", "patch": [{"offset": 56, "hex": "01"}], "fix_crc": true, "expect": "BAD_STRUCTURE", "index": 2},
    {"name": "entrada_inexistente", "patch": [{"offset": 54, "hex": "0800"}], "fix_crc": true, "expect": "BAD_OPERAND", "index": 1},
    {"name": "bobina_em_entrada", "patch": [{"offset": 52, "hex": "30"}], "fix_crc": true, "expect": "BAD_OPERAND", "index": 1},
    {"name": "numeracao_de_rede", "patch": [{"offset": 66, "hex": "0200"}], "fix_crc": true, "expect": "BAD_STRUCTURE", "index": 4},
    {"name": "ton_em_contador", "patch": [{"offset": 72, "hex": "40"}], "fix_crc": true, "expect": "BAD_OPERAND", "index": 6},
    {"name": "tipo_incompativel_tof", "patch": [{"offset": 32, "hex": "01"}], "fix_crc": true, "expect": "TYPE_MISMATCH", "index": 2},
    {"name": "instrucao_fora_de_rede", "program": [".inputs 8", ".outputs 8", "SOR", "XIC I0.0", "EOR", "XIC I0.1"], "expect": "BAD_STRUCTURE", "index": 3},
    {"name": "falta_eor", "program": [".inputs 8", ".outputs 8", "SOR", "XIC I0.0", "OTE Q0.0"], "expect": "BAD_STRUCTURE", "index": 3},
    {"name": "bnd_sem_bst", "program": [".inputs 8", ".outputs 8", "SOR", "BND", "EOR"], "expect": "BRANCH_ERROR", "index": 1},
    {"name": "nxb_sem_bst", "program": [".inputs 8", ".outputs 8", "SOR", "NXB", "EOR"], "expect": "BRANCH_ERROR", "index": 1},
    {"name": "ramo_aberto_no_eor", "program": [".inputs 8", ".outputs 8", "SOR", "BST", "XIC I0.0", "EOR"], "expect": "BRANCH_ERROR", "index": 3},
    {"name": "profundidade_maxima", "program": [".inputs 8", ".outputs 8", "SOR", "BST", "BST", "BST", "BST", "BST", "BST", "BST", "BST", "BST"], "expect": "BRANCH_ERROR", "index": 9},
    {"name": "temporizador_duplicado", "program": [".inputs 8", ".outputs 8", ".timer T0 TON 10", "SOR", "TON T0", "EOR", "SOR", "TON T0", "EOR"], "expect": "DUPLICATE_DRIVER", "index": 4},
    {"name": "ctd_em_contador_up", "program": [".inputs 8", ".outputs 8", ".counter C0 UP 1", "SOR", "CTD C0", "EOR"], "expect": "TYPE_MISMATCH", "index": 1},
    {"name": "res_em_bit", "program": [".inputs 8", ".outputs 8", "SOR", "RES I0.0", "EOR"], "expect": "BAD_OPERAND", "index": 1},
    {"name": "contato_de_temporizador_inexistente", "program": [".inputs 8", ".outputs 8", "SOR", "XIC T0.DN", "EOR"], "expect": "BAD_OPERAND", "index": 1},
    {"name": "bobina_em_bit_de_sistema", "program": [".inputs 8", ".outputs 8", "SOR", "OTE S0.0", "EOR"], "expect": "BAD_OPERAND", "index": 1}
  ]
}
