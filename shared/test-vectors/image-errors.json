    {"name": "entrada_inexistente", "patch": [{"offset": 58, "hex": "0800"}], "fix_crc": true, "expect": "BAD_OPERAND", "index": 1},
    {"name": "bobina_em_entrada", "patch": [{"offset": 56, "hex": "30"}], "fix_crc": true, "expect": "BAD_OPERAND", "index": 1},
