    {"name": "registrador_inexistente", "program": [".inputs 8", ".outputs 8", ".words 1", "SOR", "GRT N1 0", "OTE Q0.0", "EOR"], "expect": "BAD_OPERAND", "index": 1},
    {"name": "palavra_em_contato", "program": [".inputs 8", ".outputs 8", ".words 1", "SOR", "XIC N0", "OTE Q0.0", "EOR"], "expect": "BAD_OPERAND", "index": 1},
    {"name": "acumulador_de_temporizador_inexistente", "program": [".inputs 8", ".outputs 8", "SOR", "GRT T0.ACC 1", "OTE Q0.0", "EOR"], "expect": "BAD_OPERAND", "index": 1},
    {"name": "destino_entrada", "program": [".inputs 8", ".outputs 8", "SOR", "NEG 3 IW0", "EOR"], "expect": "BAD_OPERAND", "index": 2}
